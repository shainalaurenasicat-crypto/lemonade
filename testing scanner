        def normalize_text(text):
            return re.sub(r"\s+", " ", text).strip()

        def parse_value(text, label_patterns):
            for pattern in label_patterns:
                match = re.search(pattern + r"\s*[:：]?\s*([0-9]+(?:\.[0-9]+)?\s*%?)", text, re.I)
                if match:
                    return match.group(1).replace(" ", "")
            return None

        def extract_fields(all_text):
            text = normalize_text(all_text)
            result = {}
            # Character name is often shown in the Details header or stat page.
            name_match = re.search(r"(?:Character Details\s*)?([A-Z][A-Za-z' -]{2,30})\s+(?:Lv\.?|Level)", text)
            if name_match:
                candidate = name_match.group(1).strip()
                if candidate.lower() not in {"character details", "light cone"}:
                    result["name"] = candidate
            for element in ["Physical", "Fire", "Ice", "Lightning", "Wind", "Quantum", "Imaginary"]:
                if re.search(r"\b" + element + r"\b", text, re.I):
                    result["element"] = element
                    break
            for path in ["Destruction", "Hunt", "Erudition", "Harmony", "Nihility", "Preservation", "Abundance", "Remembrance"]:
                if re.search(r"\b" + path + r"\b", text, re.I):
                    result["path"] = path
                    break
            level_match = re.search(r"(?:Lv\.?|Level)\s*(\d{1,2})\s*/?\s*80?", text, re.I)
            if level_match:
                result["level"] = level_match.group(1)
            eidolon_match = re.search(r"(?:Eidolon|E)\s*([0-6])\b", text, re.I)
            if eidolon_match:
                result["eidolon"] = eidolon_match.group(1)
            stat_patterns = {
                "hp": [r"HP"], "atk": [r"ATK"], "def": [r"DEF"],
                "spd": [r"SPD"], "crit_rate": [r"CRIT\s*Rate"],
                "crit_dmg": [r"CRIT\s*DMG"],
                "effect_hit_rate": [r"Effect\s*Hit\s*Rate"],
                "break_effect": [r"Break\s*Effect"]
            }
            for key, patterns in stat_patterns.items():
                value = parse_value(text, patterns)
                if value:
                    result[key] = value
            return result

        def run_ocr(path):
            if not OCR_AVAILABLE:
                raise RuntimeError("pytesseract is not installed. Install it with: pip install pytesseract")
            if not PIL_AVAILABLE:
                raise RuntimeError("Pillow is required for screenshot processing. Install it with: pip install pillow")
            image = Image.open(path).convert("RGB")
            # Try the original and quarter-turn rotations. This helps with sideways tablet photos.
            candidates = [image, image.rotate(90, expand=True), image.rotate(270, expand=True)]
            best_text = ""
            for candidate in candidates:
                candidate = candidate.copy()
                candidate.thumbnail((2200, 2200))
                try:
                    text = pytesseract.image_to_string(candidate, config="--psm 6")
                except Exception as error:
                    raise RuntimeError(
                        "Tesseract OCR could not run. Make sure the Tesseract application is installed.\n" + str(error)
                    )
                if len(text.strip()) > len(best_text.strip()):
                    best_text = text
            return best_text

        def upload_and_scan():
            nonlocal screenshot_paths
            paths = filedialog.askopenfilenames(
                parent=window,
                title="Select HSR screenshots",
                filetypes=[("Image files", "*.png *.jpg *.jpeg *.bmp *.webp"), ("All files", "*.*")]
            )
            if not paths:
                return
            screenshot_paths = list(paths)
            upload_status.config(text=f"{len(screenshot_paths)} screenshot(s) selected")
            scan_selected()

        def scan_selected():
            if not screenshot_paths:
                messagebox.showinfo("No Screenshots", "Upload screenshots first.", parent=window)
                return
            if not OCR_AVAILABLE or not PIL_AVAILABLE:
                extracted_text.delete("1.0", "end")
                extracted_text.insert(
                    "1.0",
                    "Screenshots selected, but OCR is not ready. Install Pillow, pytesseract, "
                    "and the Tesseract OCR application. Then click Scan Screenshots again."
                )
                return
            scan_button.config(state="disabled", text="Scanning...")
            window.update_idletasks()
            text_parts = []
            try:
                for index, path in enumerate(screenshot_paths, start=1):
                    text_parts.append(f"--- Screenshot {index}: {os.path.basename(path)} ---\n{run_ocr(path)}")
                combined = "\n".join(text_parts)
                extracted_text.delete("1.0", "end")
                extracted_text.insert("1.0", combined if combined.strip() else "No readable text found.")
                detected = extract_fields(combined)
                for key, value in detected.items():
                    if key in fields and value:
                        fields[key].delete(0, "end")
                        fields[key].insert(0, value)
                messagebox.showinfo(
                    "Scan Complete",
                    f"Scanned {len(screenshot_paths)} screenshot(s).\n"
                    "Please review the detected values before saving.", parent=window
                )
            except Exception as error:
                messagebox.showerror("OCR Error", str(error), parent=window)
            finally:
                scan_button.config(state="normal", text="Scan Screenshots")

        button_row = tk.Frame(outer, bg=BG)
        button_row.pack(fill="x", pady=(0, 10))
        self.make_button(button_row, "Upload Screenshots", upload_and_scan, primary=True).pack(side="left")
        scan_button = self.make_button(button_row, "Scan Screenshots", scan_selected)
        scan_button.pack(side="left", padx=8)

        if not OCR_AVAILABLE or not PIL_AVAILABLE:
            tk.Label(
                outer,
                text="OCR setup required: pip install pillow pytesseract, plus the Tesseract OCR desktop application.",
                bg=BG, fg="#D8B77A", font=("Arial", 8), wraplength=620, justify="left"
            ).pack(anchor="w", pady=(0, 8))

        def save_character():
            name = fields["name"].get().strip()
            if not name:
                messagebox.showwarning("Missing Name", "OCR did not find the character name. Please enter it.", parent=window)
                return
            try:
                level = int(fields["level"].get())
                eidolon = int(fields["eidolon"].get())
            except ValueError:
                messagebox.showwarning("Invalid Number", "Level and Eidolon must be whole numbers.", parent=window)
                return
            if not 1 <= level <= 80 or not 0 <= eidolon <= 6:
                messagebox.showwarning("Invalid Values", "Level must be 1-80 and Eidolon must be 0-6.", parent=window)
                return
            for character in self.game_data["characters"]:
                if character is not existing and character.get("name", "").lower() == name.lower():
                    messagebox.showwarning("Duplicate Character", "That character is already in your collection.", parent=window)
                    return

            safe_name = "".join(c for c in name if c.isalnum() or c in (" ", "_", "-")).strip().replace(" ", "_")
            saved_screenshots = []
            for index, source in enumerate(screenshot_paths, start=1):
                if not os.path.isfile(source):
                    continue
                extension = os.path.splitext(source)[1].lower() or ".png"
                destination = os.path.join(SCREENSHOT_DIR, f"{safe_name}_{index}{extension}")
                try:
                    if os.path.abspath(source) != os.path.abspath(destination):
                        shutil.copy2(source, destination)
                    saved_screenshots.append(os.path.relpath(destination, BASE_DIR))
                except OSError:
                    continue

            # Keep the portrait separate from full-screen game screenshots.
            portrait = old.get("image", "")
            build = {
                key: fields[key].get().strip()
                for key in ["hp", "atk", "def", "spd", "crit_rate", "crit_dmg", "effect_hit_rate", "break_effect"]
            }
            record = {
                "name": name,
                "rarity": fields["rarity"].get(),
                "element": fields["element"].get(),
                "path": fields["path"].get(),
                "level": level,
                "eidolon": eidolon,
                "image": portrait,
                "screenshots": saved_screenshots or old.get("screenshots", []),
                "ocr_text": extracted_text.get("1.0", "end").strip(),
                "build": build,
                "equipment": old.get("equipment", {})
            }
            if editing:
                existing.update(record)
            else:
                next_id = max([item.get("id", 0) for item in self.game_data["characters"]] + [0]) + 1
                record["id"] = next_id
                self.game_data["characters"].append(record)
            self.save_game()
            window.destroy()
            self.show_character_collection()

        self.make_button(outer, "Save Character", save_character, primary=True).pack(anchor="e", pady=(10, 0))

    def delete_character(self, character):
        if not character:
            return
        if not messagebox.askyesno(
            "Delete Character",
            f"Remove {character['name']} from your collection? "
            "Any saved teams containing this character will also be updated."
        ):
            return

        character_id = character["id"]
        self.game_data["characters"].remove(character)

        for team in self.game_data["teams"]:
            team["character_ids"] = [
                item_id for item_id in team.get("character_ids", [])
                if item_id != character_id
            ]

        self.save_game()
        self.show_character_collection()

    def open_selected_build(self, character):
        if not character:
            return
        self.selected_character_id = character["id"]
        self.show_build_workshop()

    def find_selected_character(self):
        for character in self.game_data["characters"]:
            if character["id"] == self.selected_character_id:
                return character
        return None

    def show_build_workshop(self):
        self.ensure_game_layout()
        self.current_page = "build_workshop"
        self.clear_content()
        self.set_active_nav("Build Workshop")
        self.page_header(
            "Build Workshop",
            "Select a character from your collection to view or update build information."
        )

        characters = self.game_data["characters"]
        if not characters:
            tk.Label(
                self.content,
                text="Your collection is empty. Add a character first.",
                bg=BG, fg=MUTED, font=("Arial", 11)
            ).pack(pady=35)
            self.make_button(
                self.content, "Go to Character Collection",
                self.show_character_collection, primary=True
            ).pack()
            return

        names = [character["name"] for character in characters]
        selected = self.find_selected_character()
        if selected is None:
            selected = characters[0]
            self.selected_character_id = selected["id"]

        selector = ttk.Combobox(
            self.content, values=names, state="readonly", width=35
        )
        selector.set(selected["name"])
        selector.pack(anchor="w", padx=32, pady=(0, 15))

        profile = tk.Frame(self.content, bg=CARD, padx=20, pady=18)
        profile.pack(fill="x", padx=32)

        portrait_area = tk.Frame(profile, bg=CARD, width=150, height=170)
        portrait_area.pack(side="left", padx=(0, 22))
        portrait_area.pack_propagate(False)

        portrait_label = tk.Label(
            portrait_area, text="CHARACTER\nPORTRAIT",
            bg=SIDEBAR, fg=MUTED, justify="center"
        )
        portrait_label.pack(fill="both", expand=True)

        def show_profile(character):
            self.selected_character_id = character["id"]
            portrait_label.config(image="", text="CHARACTER\nPORTRAIT")
            self.character_photo = None

            image_path = character.get("image", "")
            if image_path:
                full_path = os.path.join(BASE_DIR, image_path)
                if PIL_AVAILABLE and os.path.isfile(full_path):
                    try:
                        image = Image.open(full_path)
                        image.thumbnail((145, 165))
                        self.character_photo = ImageTk.PhotoImage(image)
                        portrait_label.config(image=self.character_photo, text="")
                    except Exception:
                        pass
                elif not PIL_AVAILABLE:
                    portrait_label.config(
                        text="Install Pillow\nto display image"
                    )

            details = (
                f"{character['name']}\n\n"
                f"Rarity: {character['rarity']}\n"
                f"Element: {character['element']}\n"
                f"Path: {character['path']}\n"
                f"Level: {character['level']}\n"
                f"Eidolon: E{character['eidolon']}"
            )
            info_label.config(text=details)

            build = character.get("build", {})
            stats_label.config(
                text=(
                    f"HP: {build.get('hp', 'Not entered')}     "
                    f"ATK: {build.get('atk', 'Not entered')}     "
                    f"DEF: {build.get('def', 'Not entered')}     "
                    f"SPD: {build.get('spd', 'Not entered')}\n"
                    f"CRIT Rate: {build.get('crit_rate', 'Not entered')}     "
                    f"CRIT DMG: {build.get('crit_dmg', 'Not entered')}"
                )
            )

        info_label = tk.Label(
            profile, text="", bg=CARD, fg=TEXT,
            font=("Arial", 11), justify="left"
        )
        info_label.pack(side="left", anchor="n")

        stats_box = tk.Frame(self.content, bg=CARD, padx=18, pady=15)
        stats_box.pack(fill="x", padx=32, pady=15)

        tk.Label(
            stats_box, text="Recorded Combat Stats",
            bg=CARD, fg=HIGHLIGHT, font=("Arial", 13, "bold")
        ).pack(anchor="w", pady=(0, 10))

        stats_label = tk.Label(
            stats_box, text="", bg=CARD, fg=TEXT,
            font=("Arial", 10), justify="left"
        )
        stats_label.pack(anchor="w")

        def change_character(_event=None):
            name = selector.get()
            for item in characters:
                if item["name"] == name:
                    show_profile(item)
                    break

        selector.bind("<<ComboboxSelected>>", change_character)
        show_profile(selected)

        self.make_button(
            self.content, "Edit Build Stats",
            lambda: self.edit_build_dialog(self.find_selected_character()),
            primary=True
        ).pack(anchor="w", padx=32, pady=5)

        if not PIL_AVAILABLE:
            tk.Label(
                self.content,
                text="Optional: install Pillow with 'pip install pillow' to display uploaded portraits.",
                bg=BG, fg=MUTED, font=("Arial", 8)
            ).pack(anchor="w", padx=32, pady=5)

    def edit_build_dialog(self, character):
        if not character:
            return

        window = tk.Toplevel(self.root)
        window.title("Edit Build Stats")
        window.geometry("390x540")
        window.configure(bg=BG)
        window.transient(self.root)
        window.grab_set()

        tk.Label(
            window, text=f"{character['name']} - Build Stats",
            bg=BG, fg=TEXT, font=("Arial", 16, "bold")
        ).pack(pady=20)

        current = character.setdefault("build", {})
        fields = {}
        for label, key in [
            ("HP", "hp"), ("ATK", "atk"), ("DEF", "def"), ("SPD", "spd"),
            ("CRIT Rate", "crit_rate"), ("CRIT DMG", "crit_dmg"),
            ("Effect Hit Rate", "effect_hit_rate"), ("Break Effect", "break_effect")
        ]:
            tk.Label(window, text=label, bg=BG, fg=TEXT).pack(
                anchor="w", padx=35
            )
            entry = tk.Entry(
                window, bg=CARD, fg=TEXT,
                insertbackground=TEXT, relief="flat"
            )
            entry.pack(fill="x", padx=35, pady=(3, 8), ipady=5)
            entry.insert(0, str(current.get(key, "")))
            fields[key] = entry

        def save_build():
            self.selected_character_id = character["id"]
            character["build"] = {
                key: entry.get().strip()
                for key, entry in fields.items()
            }
            self.save_game()
            window.destroy()
            self.show_build_workshop()

        self.make_button(
            window, "Save Build Stats", save_build, primary=True
        ).pack(pady=15)

    # --------------------------------------------------------
    # TEAM BUILDER
    # --------------------------------------------------------

    def show_team_builder(self):
        self.ensure_game_layout()
        self.current_page = "team_builder"
        self.clear_content()
        self.set_active_nav("Team Builder")
        self.page_header(
            "Team Builder",
            "Create a team using four different characters from your collection."
        )

        characters = self.game_data["characters"]
        if len(characters) < 4:
            tk.Label(
                self.content,
                text="Add at least four characters to your collection before creating a team.",
                bg=BG, fg=MUTED, font=("Arial", 11)
            ).pack(pady=30)
            self.make_button(
                self.content, "Open Character Collection",
                self.show_character_collection, primary=True
            ).pack()
            return

        form = tk.Frame(self.content, bg=CARD, padx=22, pady=20)
        form.pack(fill="x", padx=32, pady=10)

        tk.Label(form, text="Team Name", bg=CARD, fg=TEXT).pack(anchor="w")
        team_name = tk.Entry(
            form, bg=SIDEBAR, fg=TEXT, insertbackground=TEXT, relief="flat"
        )
        team_name.pack(fill="x", pady=(5, 15), ipady=7)

        tk.Label(
            form, text="Choose exactly four characters",
            bg=CARD, fg=TEXT, font=("Arial", 10, "bold")
        ).pack(anchor="w", pady=(0, 8))

        selected_ids = set()
        checks_frame = tk.Frame(form, bg=CARD)
        checks_frame.pack(fill="x")

        for character in characters:
            variable = tk.BooleanVar(value=False)

            def toggle_character(char_id=character["id"], var=variable):
                if var.get():
                    if len(selected_ids) >= 4:
                        var.set(False)
                        messagebox.showwarning(
                            "Team Limit",
                            "A team can contain exactly four characters."
                        )
                        return
                    selected_ids.add(char_id)
                else:
                    selected_ids.discard(char_id)
                count_label.config(
                    text=f"Selected: {len(selected_ids)} / 4"
                )

            check = tk.Checkbutton(
                checks_frame,
                text=character["name"],
                variable=variable,
                command=toggle_character,
                bg=CARD, fg=TEXT, selectcolor=SIDEBAR,
                activebackground=CARD, activeforeground=TEXT
            )
            check.pack(anchor="w")

        count_label = tk.Label(
            form, text="Selected: 0 / 4",
            bg=CARD, fg=HIGHLIGHT, font=("Arial", 10, "bold")
        )
        count_label.pack(anchor="w", pady=12)

        def save_team():
            name = team_name.get().strip()
            if not name:
                messagebox.showwarning("Missing Name", "Enter a team name.")
                return
            if len(selected_ids) != 4:
                messagebox.showwarning(
                    "Team Incomplete", "Select exactly four different characters."
                )
                return

            next_id = max(
                [team.get("id", 0) for team in self.game_data["teams"]] + [0]
            ) + 1
            self.game_data["teams"].append({
                "id": next_id,
                "name": name,
                "character_ids": list(selected_ids)
            })
            self.save_game()
            messagebox.showinfo("Team Saved", f"'{name}' has been saved.")
            self.show_team_builder()

        self.make_button(
            form, "Save Team", save_team, primary=True
        ).pack(anchor="e")

        saved = tk.Frame(self.content, bg=BG)
        saved.pack(fill="both", expand=True, padx=32, pady=15)

        tk.Label(
            saved, text="Saved Teams", bg=BG, fg=TEXT,
            font=("Arial", 14, "bold")
        ).pack(anchor="w", pady=(0, 8))

        for team in self.game_data["teams"]:
            names = []
            for char_id in team.get("character_ids", []):
                for character in characters:
                    if character["id"] == char_id:
                        names.append(character["name"])
            tk.Label(
                saved,
                text=f"{team['name']}: {', '.join(names)}",
                bg=CARD, fg=TEXT, anchor="w", padx=12, pady=9
            ).pack(fill="x", pady=3)

    # --------------------------------------------------------
    # BUILD COMPARISON - BASIC RECORDED STAT COMPARISON
    # --------------------------------------------------------

    def show_build_comparison(self):
        self.ensure_game_layout()
        self.current_page = "build_comparison"
        self.clear_content()
        self.set_active_nav("Build Comparison")
        self.page_header(
            "Build Comparison",
            "Compare recorded stats for two characters in your collection."
        )

        characters = self.game_data["characters"]
        if len(characters) < 2:
            tk.Label(
                self.content,
                text="Add at least two characters to use this comparison page.",
                bg=BG, fg=MUTED
            ).pack(pady=30)
            return

        names = [character["name"] for character in characters]
        left = ttk.Combobox(self.content, values=names, state="readonly")
        right = ttk.Combobox(self.content, values=names, state="readonly")
        left.set(names[0])
        right.set(names[1])

        controls = tk.Frame(self.content, bg=BG)
        controls.pack(fill="x", padx=32, pady=15)
        left.pack(in_=controls, side="left", padx=(0, 10), ipady=5)
        right.pack(in_=controls, side="left", ipady=5)

        result = tk.Label(
            self.content, text="Choose two characters and select Compare.",
            bg=BG, fg=TEXT, font=("Arial", 11), justify="left"
        )
        result.pack(anchor="w", padx=32, pady=20)

        def compare():
            first = next((c for c in characters if c["name"] == left.get()), None)
            second = next((c for c in characters if c["name"] == right.get()), None)
            if not first or not second or first["id"] == second["id"]:
                messagebox.showwarning(
                    "Choose Two Characters",
                    "Select two different characters."
                )
                return

            stats = ["hp", "atk", "def", "spd", "crit_rate", "crit_dmg"]
            lines = [f"{'STAT':<15} {first['name']:<18} {second['name']}"]
            lines.append("-" * 55)
            for stat in stats:
                a = first.get("build", {}).get(stat, "—") or "—"
                b = second.get("build", {}).get(stat, "—") or "—"
                lines.append(f"{stat.upper():<15} {str(a):<18} {b}")
            result.config(text="\n".join(lines), font=("Courier New", 10))

        self.make_button(
            self.content, "Compare", compare, primary=True
        ).pack(anchor="w", padx=32)

        tk.Label(
            self.content,
            text="This compares entered values only; it does not calculate damage or recommend an optimal build.",
            bg=BG, fg=MUTED, font=("Arial", 8)
        ).pack(anchor="w", padx=32, pady=12)


