    def apply_palette(self, theme_name, refresh=True):
        """Apply one theme to every screen in the application."""
        global BG, SIDEBAR, CARD, ACCENT, SELECTED, HIGHLIGHT, TEXT, MUTED, BORDER
        if theme_name not in THEMES:
            return
        self.current_theme = theme_name
        palette = THEMES[theme_name]
        BG = palette["BG"]
        SIDEBAR = palette["SIDEBAR"]
        CARD = palette["CARD"]
        ACCENT = palette["ACCENT"]
        SELECTED = palette["SELECTED"]
        HIGHLIGHT = palette["HIGHLIGHT"]
        TEXT = palette["TEXT"]
        MUTED = palette["MUTED"]
        BORDER = palette["BORDER"]
        self.root.configure(bg=BG)
        if refresh:
            save_json(SETTINGS_FILE, {"theme": theme_name})
            self.setup_styles()
            page = self.current_page
            if page == "landing" or self.current_mode is None:
                self.show_landing_page()
            elif self.current_mode == "academic":
                if page == "academic_list":
                    self.show_all_tasks()
                else:
                    self.show_academic_dashboard()
            elif self.current_mode == "game":
                game_pages = {
                    "game_dashboard": self.show_game_dashboard,
                    "character_collection": self.show_character_collection,
                    "build_workshop": self.show_build_workshop,
                    "team_builder": self.show_team_builder,
                    "build_comparison": self.show_build_comparison,
                }
                game_pages.get(page, self.show_game_dashboard)()

    def open_theme_settings(self):
        """Show a theme picker that applies changes immediately."""
        window = tk.Toplevel(self.root)
        window.title("TaskTrack Appearance")
        window.geometry("540x590")
        window.resizable(False, False)
        window.configure(bg=BG)
        window.transient(self.root)
        window.grab_set()

        tk.Label(window, text="Choose Your Theme", bg=BG, fg=TEXT,
                 font=("Arial", 19, "bold")).pack(anchor="w", padx=24, pady=(22, 4))
        tk.Label(window, text="Your selection changes both Academic Mode and Game Mode.",
                 bg=BG, fg=MUTED, font=("Arial", 9)).pack(anchor="w", padx=24, pady=(0, 16))

        grid = tk.Frame(window, bg=BG)
        grid.pack(fill="both", expand=True, padx=18, pady=4)
        for index, (name, colors) in enumerate(THEMES.items()):
            row, col = divmod(index, 2)
            swatch = tk.Frame(grid, bg=colors["CARD"], highlightthickness=1,
                              highlightbackground=colors["BORDER"], padx=12, pady=10)
            swatch.grid(row=row, column=col, padx=6, pady=6, sticky="nsew")
            tk.Label(swatch, text=name, bg=colors["CARD"], fg=colors["TEXT"],
                     font=("Arial", 10, "bold")).pack(anchor="w")
            strip = tk.Frame(swatch, bg=colors["CARD"])
            strip.pack(anchor="w", pady=8)
            for color in (colors["BG"], colors["SIDEBAR"], colors["ACCENT"], colors["HIGHLIGHT"]):
                tk.Frame(strip, bg=color, width=30, height=18).pack(side="left", padx=(0, 5))
            tk.Button(swatch, text="Apply Theme", command=lambda n=name: self.apply_palette(n),
                      bg=colors["ACCENT"], fg=colors["TEXT"], activebackground=colors["SELECTED"],
                      activeforeground=colors["TEXT"], relief="flat", bd=0, padx=10, pady=6,
                      cursor="hand2").pack(anchor="w")
        for col in range(2):
            grid.grid_columnconfigure(col, weight=1)
        self.make_button(window, "Close", window.destroy).pack(pady=(8, 18))

