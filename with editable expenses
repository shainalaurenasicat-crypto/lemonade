    def set_allowance_dialog(self):
        window = tk.Toplevel(self.root)
        window.title("Set Monthly Allowance")
        window.geometry("390x240")
        window.resizable(False, False)
        window.configure(bg=BG)
        window.transient(self.root)
        window.grab_set()

        tk.Label(
            window, text="Set Monthly Allowance", bg=BG, fg=TEXT,
            font=("Arial", 17, "bold")
        ).pack(anchor="w", padx=25, pady=(22, 8))
        tk.Label(
            window, text="Enter the money you have available for this month.",
            bg=BG, fg=MUTED, font=("Arial", 9)
        ).pack(anchor="w", padx=25)

        entry = tk.Entry(
            window, bg=CARD, fg=TEXT, insertbackground=TEXT,
            relief="flat", font=("Arial", 12)
        )
        entry.pack(fill="x", padx=25, pady=15, ipady=8)
        entry.insert(0, str(self.finance_data.get("allowance", 0) or ""))

        def save_allowance():
            amount = self.parse_money(entry.get())
            if amount is None or amount < 0:
                messagebox.showwarning(
                    "Invalid Amount", "Enter a valid allowance amount (zero or more).",
                    parent=window
                )
                return
            self.push_finance_undo()
            self.finance_data["allowance"] = round(amount, 2)
            self.save_finance()
            window.destroy()
            self.show_finance_dashboard()

        self.make_button(
            window, "Save Allowance", save_allowance, primary=True
        ).pack(pady=4)

    @staticmethod
    def parse_money(value):
        """Accept positive currency values with up to two decimal places."""
        try:
            amount = Decimal(value.strip().replace(",", "").replace("₱", ""))
            if not amount.is_finite() or amount < 0:
                return None
            return float(amount.quantize(Decimal("0.01")))
        except (InvalidOperation, ValueError, AttributeError):
            return None

    def add_finance_transaction(self, transaction_type="expense", existing=None):
        editing = existing is not None
        is_income = transaction_type == "income"
        title = "Edit Transaction" if editing else (
            "Add Additional Money" if is_income else "Add Expense"
        )
        window = tk.Toplevel(self.root)
        window.title(title)
        window.geometry("430x330")
        window.resizable(False, False)
        window.configure(bg=BG)
        window.transient(self.root)
        window.grab_set()

        tk.Label(
            window, text=title, bg=BG, fg=TEXT,
            font=("Arial", 18, "bold")
        ).pack(anchor="w", padx=28, pady=(22, 16))

        tk.Label(
            window, text="Description", bg=BG, fg=MUTED,
            font=("Arial", 9)
        ).pack(anchor="w", padx=28)
        description = tk.Entry(
            window, bg=CARD, fg=TEXT, insertbackground=TEXT,
            relief="flat", font=("Arial", 11)
        )
        description.pack(fill="x", padx=28, pady=(5, 14), ipady=8)
        description.insert(0, existing.get("description", "") if editing else "")

        tk.Label(
            window, text="Amount (₱)", bg=BG, fg=MUTED,
            font=("Arial", 9)
        ).pack(anchor="w", padx=28)
        amount_entry = tk.Entry(
            window, bg=CARD, fg=TEXT, insertbackground=TEXT,
            relief="flat", font=("Arial", 11)
        )
        amount_entry.pack(fill="x", padx=28, pady=(5, 14), ipady=8)
        amount_entry.insert(0, str(existing.get("amount", "")) if editing else "")

        def save_transaction():
            label = description.get().strip()
            amount = self.parse_money(amount_entry.get())
            if not label:
                messagebox.showwarning(
                    "Missing Description", "Enter what the transaction is for.",
                    parent=window
                )
                return
            if amount is None or amount <= 0:
                messagebox.showwarning(
                    "Invalid Amount", "Enter an amount greater than zero.",
                    parent=window
                )
                return

            self.push_finance_undo()
            if editing:
                existing["description"] = label
                existing["amount"] = amount
            else:
                next_id = max(
                    [item.get("id", 0) for item in self.finance_data["transactions"]] + [0]
                ) + 1
                self.finance_data["transactions"].append({
                    "id": next_id,
                    "type": transaction_type,
                    "description": label,
                    "amount": amount,
                    "date": date.today().isoformat()
                })
            self.save_finance()
            window.destroy()
            if self.current_page == "finance_history":
                self.show_finance_history()
            else:
                self.show_finance_dashboard()

        self.make_button(
            window, "Save Transaction", save_transaction, primary=True
        ).pack(pady=8)

    def add_income_dialog(self):
        self.add_finance_transaction("income")

    def create_finance_table(self, parent, transactions):
        columns = ("date", "description", "type", "amount")
        table = ttk.Treeview(parent, columns=columns, show="headings", height=7)
        headings = {
            "date": "Date", "description": "Description",
            "type": "Transaction", "amount": "Amount"
        }
        widths = {"date": 110, "description": 250, "type": 130, "amount": 130}
        for column in columns:
            table.heading(column, text=headings[column])
            table.column(column, width=widths[column], minwidth=75)
        for item in transactions:
            kind = item.get("type", "expense")
            prefix = "+" if kind == "income" else "−"
            table.insert(
                "", "end", iid=str(item.get("id")),
                values=(
                    item.get("date", ""),
                    item.get("description", ""),
                    "Additional Money" if kind == "income" else "Expense",
                    f"{prefix} ₱{float(item.get('amount', 0) or 0):,.2f}"
                )
            )
        table.pack(fill="both", expand=True)
        return table

    def show_finance_history(self):
        self.rollover_finance_month()
        self.ensure_finance_layout()
        self.current_page = "finance_history"
        self.clear_content()
        self.set_active_nav("Expense History")
        self.page_header(
            "Transaction History",
            "Select a transaction and click Edit, or double-click a row to change its description or amount."
        )

        toolbar = tk.Frame(self.content, bg=BG)
        toolbar.pack(fill="x", padx=32, pady=(0, 12))
        search_var = tk.StringVar()
        search = tk.Entry(
            toolbar, textvariable=search_var, bg=CARD, fg=TEXT,
            insertbackground=TEXT, relief="flat", font=("Arial", 10)
        )
        search.pack(side="left", fill="x", expand=True, ipady=9)

        table_area = tk.Frame(self.content, bg=BG)
        table_area.pack(fill="both", expand=True, padx=32)
        table = self.create_finance_table(
            table_area, self.finance_data["transactions"]
        )

        def refresh(*_):
            query = search_var.get().casefold().strip()
            for row in table.get_children():
                table.delete(row)
            # Linear search through transaction descriptions and dates.
            for item in self.finance_data["transactions"]:
                searchable = (
                    item.get("description", "") + " " + item.get("date", "") +
                    " " + item.get("type", "")
                ).casefold()
                if query and query not in searchable:
                    continue
                kind = item.get("type", "expense")
                prefix = "+" if kind == "income" else "−"
                table.insert(
                    "", "end", iid=str(item.get("id")),
                    values=(
                        item.get("date", ""), item.get("description", ""),
                        "Additional Money" if kind == "income" else "Expense",
                        f"{prefix} ₱{float(item.get('amount', 0) or 0):,.2f}"
                    )
                )

        search_var.trace_add("write", refresh)

        def selected_transaction():
            selection = table.selection()
            if not selection:
                messagebox.showinfo("Select Transaction", "Please select a transaction first.")
                return None
            selected_id = int(selection[0])
            return next(
                (item for item in self.finance_data["transactions"]
                 if item.get("id") == selected_id),
                None
            )

        def edit_selected():
            item = selected_transaction()
            if item:
                self.add_finance_transaction(item.get("type", "expense"), item)

        # Quick editing: double-click a transaction row to open its edit form.
        table.bind("<Double-1>", lambda _event: edit_selected())

        def delete_selected():
            item = selected_transaction()
            if not item:
                return
            if messagebox.askyesno(
                "Delete Transaction",
                f"Delete '{item.get('description', 'transaction')}'?"
            ):
                self.push_finance_undo()
                self.finance_data["transactions"].remove(item)
                self.save_finance()
                self.show_finance_history()

        buttons = tk.Frame(self.content, bg=BG)
        buttons.pack(fill="x", padx=32, pady=18)
        self.make_button(
            buttons, "+ Add Expense", self.add_finance_transaction,
            primary=True
        ).pack(side="right", padx=(8, 0))
        self.make_button(
            buttons, "+ Add Money", self.add_income_dialog
        ).pack(side="right", padx=(8, 0))
        self.make_button(
            buttons, "Edit Selected", edit_selected
        ).pack(side="right", padx=(8, 0))
        self.make_button(
            buttons, "Delete Selected", delete_selected
        ).pack(side="right", padx=(8, 0))
        self.make_button(
            buttons, "Undo Last Action", self.undo_finance_action
        ).pack(side="left")



