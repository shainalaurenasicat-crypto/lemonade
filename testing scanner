            window, "Save Task", save_task, primary=True
        ).pack(pady=16)

    def selected_task(self, table):
        selection = table.selection()
        if not selection:
            messagebox.showinfo("Select Task", "Please select a task first.")
            return None
        task_id = int(selection[0])
        for task in self.academic_data["tasks"]:
