    def ensure_academic_layout(self):
        if self.current_mode != "academic":
            self.build_mode_layout("academic", self.academic_navigation())

    def save_academic(self):
        save_json(ACADEMIC_FILE, self.academic_data)

    def push_undo_state(self):
        # Store a copy so later edits do not change the saved undo state.
        self.undo_stack.push(json.dumps(self.academic_data))

    def undo_academic_action(self):
        previous = self.undo_stack.pop()
        if previous is None:
            messagebox.showinfo("Undo", "There are no actions to undo.")
            return

        self.academic_data = json.loads(previous)
        self.save_academic()
        self.show_academic_dashboard()
        messagebox.showinfo("Undo", "The previous academic task state was restored.")

    def show_academic_dashboard(self):
        self.ensure_academic_layout()
        self.current_page = "academic_dashboard"
        self.clear_content()
        self.set_active_nav("Dashboard")

        tasks = self.academic_data["tasks"]
        total = len(tasks)
        completed = sum(1 for item in tasks if item.get("status") == "Completed")
        pending = total - completed
        major = sum(1 for item in tasks if item.get("category") == "Major")
        minor = sum(1 for item in tasks if item.get("category") == "Minor")

        self.page_header(
            "Academic Dashboard",
            "Keep track of your subjects, assignments, and deadlines."
        )

        stats = tk.Frame(self.content, bg=BG)
        stats.pack(fill="x", padx=32)

        cards = [
            ("Total Tasks", total),
            ("Pending", pending),
            ("Completed", completed),
            ("Major / Minor", f"{major} / {minor}")
        ]
        for title, value in cards:
            self.make_card(stats, title, value).pack(
                side="left", fill="both", expand=True, padx=(0, 10)
            )

        section = tk.Frame(self.content, bg=BG)
        section.pack(fill="both", expand=True, padx=32, pady=25)

        tk.Label(
            section, text="Recent Tasks", bg=BG, fg=TEXT,
            font=("Arial", 15, "bold")
        ).pack(anchor="w", pady=(0, 12))

        self.create_task_table(section, tasks[:8])

        actions = tk.Frame(section, bg=BG)
        actions.pack(fill="x", pady=14)

        self.make_button(
            actions, "+ Add Task", self.add_task_dialog, primary=True
        ).pack(side="right", padx=(8, 0))
        self.make_button(
            actions, "Undo Last Action", self.undo_academic_action
        ).pack(side="right")

    def create_task_table(self, parent, tasks, show_actions=True):
        columns = ("title", "subject", "category", "due", "priority", "status")
        table = ttk.Treeview(parent, columns=columns, show="headings")

        headings = {
            "title": "Task",
            "subject": "Subject",
            "category": "Category",
            "due": "Due Date",
            "priority": "Priority",
            "status": "Status"
        }
        widths = {
            "title": 190, "subject": 150, "category": 85,
            "due": 105, "priority": 85, "status": 100
        }

        for column in columns:
            table.heading(column, text=headings[column])
            table.column(column, width=widths[column], minwidth=65)

        for task in tasks:
            table.insert(
                "", "end", iid=str(task.get("id", id(task))),
                values=(
                    task.get("title", ""),
                    task.get("subject", ""),
                    task.get("category", ""),
                    task.get("due", ""),
                    task.get("priority", ""),
                    task.get("status", "Pending")
                )
            )

        table.pack(fill="both", expand=True)

        if show_actions:
            table.bind("<Double-1>", lambda event: self.edit_selected_task(table))
        return table

    def add_task_dialog(self, existing_task=None):
        editing = existing_task is not None
        window = tk.Toplevel(self.root)
        window.title("Edit Task" if editing else "Add Task")
        window.geometry("430x560")
        window.configure(bg=BG)
        window.resizable(False, False)
        window.transient(self.root)
        window.grab_set()

        tk.Label(
            window,
            text="Edit Task" if editing else "Add New Task",
            bg=BG, fg=TEXT, font=("Arial", 18, "bold")
        ).pack(pady=(22, 16))

        fields = {}

        def add_entry(label, key, initial=""):
            tk.Label(
                window, text=label, bg=BG, fg=TEXT,
                font=("Arial", 9)
            ).pack(anchor="w", padx=35)
            entry = tk.Entry(
                window, bg=CARD, fg=TEXT,
                insertbackground=TEXT, relief="flat"
            )
            entry.pack(fill="x", padx=35, pady=(5, 12), ipady=7)
            entry.insert(0, initial)
            fields[key] = entry

        add_entry("Task Title", "title", existing_task.get("title", "") if editing else "")
        add_entry("Subject Name", "subject", existing_task.get("subject", "") if editing else "")

        tk.Label(
            window, text="Subject Category", bg=BG, fg=TEXT
        ).pack(anchor="w", padx=35)
        category = ttk.Combobox(
            window, values=["Major", "Minor"], state="readonly"
        )
        category.set(existing_task.get("category", "Major") if editing else "Major")
        category.pack(fill="x", padx=35, pady=(5, 12), ipady=4)

        add_entry(
            "Due Date (YYYY-MM-DD)", "due",
            existing_task.get("due", "") if editing else ""
        )

        tk.Label(
            window, text="Priority", bg=BG, fg=TEXT
        ).pack(anchor="w", padx=35)
        priority = ttk.Combobox(
            window, values=["High", "Medium", "Low"], state="readonly"
        )
        priority.set(existing_task.get("priority", "Medium") if editing else "Medium")
        priority.pack(fill="x", padx=35, pady=(5, 12), ipady=4)

        def save_task():
            title = fields["title"].get().strip()
            subject = fields["subject"].get().strip()
            due = fields["due"].get().strip()

            if not title or not subject or not due:
                messagebox.showwarning(
                    "Missing Information",
                    "Please enter a task title, subject, and due date.",
                    parent=window
                )
                return

            try:
                date.fromisoformat(due)
            except ValueError:
                messagebox.showwarning(
                    "Invalid Date",
                    "Enter the date using YYYY-MM-DD.",
                    parent=window
                )
                return

            if editing:
                self.push_undo_state()
                existing_task.update({
                    "title": title,
                    "subject": subject,
                    "category": category.get(),
                    "due": due,
                    "priority": priority.get()
                })
            else:
                self.push_undo_state()
                next_id = max(
                    [item.get("id", 0) for item in self.academic_data["tasks"]] + [0]
                ) + 1
                self.academic_data["tasks"].append({
                    "id": next_id,
                    "title": title,
                    "subject": subject,
                    "category": category.get(),
                    "due": due,
                    "priority": priority.get(),
                    "status": "Pending"
                })

            self.save_academic()
            window.destroy()
            self.show_academic_dashboard()

