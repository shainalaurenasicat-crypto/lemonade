        if not task:
            return
        if messagebox.askyesno("Delete Task", f"Delete '{task['title']}'?"):
            self.push_undo_state()
            self.academic_data["tasks"].remove(task)
            self.save_academic()
            self.show_all_tasks()

    def complete_selected_task(self, table):
        task = self.selected_task(table)
        if not task:
            return
        if task.get("status") == "Completed":
            messagebox.showinfo("Task Status", "This task is already completed.")
            return
        self.push_undo_state()
        task["status"] = "Completed"
        self.save_academic()
        self.show_all_tasks()

    def linear_search_tasks(self, query, category=None):
        """Linear search through task titles and subject names."""
        matches = []
        query = query.lower().strip()
        for task in self.academic_data["tasks"]:
            if category and task.get("category") != category:
                continue
            searchable = (
                task.get("title", "").lower()
                + " "
                + task.get("subject", "").lower()
            )
            if query in searchable:
                matches.append(task)
        return matches

    def insertion_sort_tasks(self, tasks):
        """Insertion sort by due date, earliest first."""
        result = tasks[:]
        for index in range(1, len(result)):
            current = result[index]
            position = index - 1
            while position >= 0 and result[position].get("due", "") > current.get("due", ""):
                result[position + 1] = result[position]
                position -= 1
            result[position + 1] = current
        return result

