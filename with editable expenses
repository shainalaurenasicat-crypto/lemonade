    def rollover_finance_month(self):
        """Archive the previous month's records when a new month begins."""
        current_month = date.today().strftime("%Y-%m")
        saved_month = self.finance_data.get("month", current_month)
        if saved_month != current_month:
            old_transactions = self.finance_data.get("transactions", [])
            old_allowance = float(self.finance_data.get("allowance", 0) or 0)
            if old_transactions or old_allowance:
                self.finance_data.setdefault("archive", []).append({
                    "month": saved_month,
                    "allowance": old_allowance,
                    "transactions": old_transactions
                })
            self.finance_data["month"] = current_month
            self.finance_data["allowance"] = 0.0
            self.finance_data["transactions"] = []
            self.save_finance()

    def save_finance(self):
        save_json(FINANCE_FILE, self.finance_data)

    def finance_totals(self):
        """Calculate income, expenses, and the current available balance."""
        allowance = float(self.finance_data.get("allowance", 0) or 0)
        extra_income = sum(
            float(item.get("amount", 0) or 0)
            for item in self.finance_data["transactions"]
            if item.get("type") == "income"
        )
        expenses = sum(
            float(item.get("amount", 0) or 0)
            for item in self.finance_data["transactions"]
            if item.get("type") == "expense"
        )
        return allowance, extra_income, expenses, allowance + extra_income - expenses

    def finance_navigation(self):
        return [
            ("Dashboard", self.show_finance_dashboard),
            ("Expense History", self.show_finance_history),
        ]

    def ensure_finance_layout(self):
        if self.current_mode != "finance":
            self.build_mode_layout("finance", self.finance_navigation())

    def push_finance_undo(self):
        self.finance_undo_stack.push(json.dumps(self.finance_data))

    def undo_finance_action(self):
        previous = self.finance_undo_stack.pop()
        if previous is None:
            messagebox.showinfo("Undo", "There are no finance actions to undo.")
            return
        self.finance_data = json.loads(previous)
        self.save_finance()
        self.show_finance_dashboard()
        messagebox.showinfo("Undo", "The previous finance action was restored.")

