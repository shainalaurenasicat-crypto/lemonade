# ============================================================
# BASIC JSON STORAGE
# ============================================================

def load_json(path, default_data):
    """Load JSON data. Return default_data if the file does not exist."""
    if not os.path.exists(path):
        return default_data

    try:
        with open(path, "r", encoding="utf-8") as file:
            return json.load(file)
    except (json.JSONDecodeError, OSError):
        messagebox.showwarning(
            "Data file problem",
            f"Could not read {os.path.basename(path)}. "
            "The application will start with empty data."
        )
        return default_data


def save_json(path, data):
    """Save data as readable JSON."""
    try:
        with open(path, "w", encoding="utf-8") as file:
            json.dump(data, file, indent=4, ensure_ascii=False)
        return True
    except OSError as error:
        messagebox.showerror("Save error", f"Could not save data:\n{error}")
        return False


# ============================================================
# SIMPLE STACK FOR ACADEMIC UNDO
# ============================================================

class ActionStack:
    """A small stack that stores previous academic task states."""

    def __init__(self):
        self.items = []

    def push(self, value):
        self.items.append(value)

    def pop(self):
        if self.is_empty():
            return None
        return self.items.pop()

    def is_empty(self):
        return len(self.items) == 0


